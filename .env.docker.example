# =============================================================================
# SIBIP con Docker · copie este archivo como .env y complete lo marcado con <...>
#   Linux/macOS:  cp .env.docker.example .env
#   Windows:      copy .env.docker.example .env
# Guía completa: DOCKER.md
# =============================================================================

# --- Puertos en este equipo ----------------------------------------------------
# Dirección del sistema: http://localhost:8080 (o http://<IP-del-equipo>:8080 en la red)
APP_PORT=8080
# phpMyAdmin (solo con: docker compose --profile tools up -d)
PMA_PORT=8081

# --- Aplicación ----------------------------------------------------------------
APP_NAME=SIBIP
APP_ENV=production
APP_DEBUG=false
# Si la deja vacía, el sistema genera una al primer arranque y la guarda en el
# volumen "sistema". Recomendado: cópiela aquí después (vea DOCKER.md).
APP_KEY=
# La dirección con la que se entra al sistema (con la IP si se usa en la red).
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Registros a la salida del contenedor:  docker compose logs app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Base de datos (servicio "db" de docker-compose) --------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sibip
DB_USERNAME=sibip
# Contraseñas largas y aleatorias. No las cambie después de crear la base:
# MySQL las guarda en el volumen la primera vez.
DB_PASSWORD=<contraseña-de-la-base>
DB_ROOT_PASSWORD=<contraseña-de-root-de-mysql>

# --- Sesión ----------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
# false mientras se use por http:// (red local). Con HTTPS (túnel o dominio): true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Con un túnel HTTPS (cloudflared) o un proxy delante, ponga * para que el sistema
# sepa que la conexión original es HTTPS. Vacío si se entra directo.
SIBIP_PROXIES_CONFIABLES=

# --- Correo (recuperación de contraseña) ---------------------------------------
# "log" no envía nada (los correos van a los registros). Para enviar de verdad,
# use SMTP: vea el ejemplo de Gmail con contraseña de aplicación en .env.example.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sibip@example.com"
MAIL_FROM_NAME="SIBIP"

# --- Primer arranque ------------------------------------------------------------
# Administrador inicial: se crea una sola vez si el correo no existe. La contraseña
# es temporal (se pide cambiarla al entrar). Después puede borrar SIBIP_ADMIN_PASSWORD.
SIBIP_ADMIN_EMAIL=<correo-del-administrador>
SIBIP_ADMIN_PASSWORD=<contraseña-temporal>
SIBIP_ADMIN_NOMBRE=Administrador
SIBIP_ADMIN_APELLIDO=SIBIP

# true carga datos de demostración (3 sedes, 55 bienes y las cuentas demo de
# README.md). Solo para probar: NO lo use con datos reales.
SIBIP_SEED_DEMO=false

# --- Reportes y respaldos --------------------------------------------------------
SIBIP_LIMITE_EXCEL_DIRECTO=1000
SIBIP_RESPALDOS_DIAS=14
SIBIP_RESPALDOS_HORA=02:30
SIBIP_MYSQLDUMP=mysqldump
