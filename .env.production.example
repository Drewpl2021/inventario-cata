# =============================================================================
# SIBIP · Plantilla de .env para PRODUCCIÓN
# Copie este archivo como .env en el servidor y complete los valores marcados
# con <...>. Nunca suba el .env real al repositorio.
# Después de cambiarlo: php artisan config:cache
# =============================================================================

APP_NAME=SIBIP
APP_ENV=production
# Genere la clave UNA sola vez con: php artisan key:generate
# (si se cambia, se pierden las sesiones y los datos cifrados).
APP_KEY=
APP_DEBUG=false
APP_URL=https://<dominio-del-sistema>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Registro diario, se conservan 30 días. Solo advertencias y errores.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sibip
# Usuario de MySQL exclusivo para SIBIP (no use root).
DB_USERNAME=sibip
DB_PASSWORD=<contraseña-larga-y-aleatoria>

# Sesión: 120 minutos de inactividad, cifrada y solo por HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Requiere un worker en marcha (supervisor o cron): php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database

# Correo para la recuperación de contraseña (ejemplo con Gmail y contraseña de
# aplicación; vea .env.example para los pasos).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<cuenta@cata.edu.pe>
MAIL_PASSWORD=<contraseña-de-aplicación>
MAIL_FROM_ADDRESS="<cuenta@cata.edu.pe>"
MAIL_FROM_NAME="SIBIP - Colegio Adventista Túpac Amaru"

VITE_APP_NAME="${APP_NAME}"

# Administrador inicial: solo para el primer "php artisan db:seed --force".
# La contraseña es temporal (se pide cambiarla al entrar). Bórrela de aquí después.
SIBIP_ADMIN_EMAIL=<correo-del-administrador>
SIBIP_ADMIN_PASSWORD=<contraseña-temporal>
SIBIP_ADMIN_NOMBRE=Administrador
SIBIP_ADMIN_APELLIDO=SIBIP

# Reportes: por encima de este número de registros, el Excel se genera en la cola.
SIBIP_LIMITE_EXCEL_DIRECTO=1000

# Respaldos diarios (php artisan sibip:respaldar): carpeta, días que se conservan, hora y ruta de mysqldump.
SIBIP_RESPALDOS_DIAS=14
SIBIP_RESPALDOS_HORA=02:30
# SIBIP_RESPALDOS_RUTA=/var/www/sibip/storage/app/respaldos
# SIBIP_MYSQLDUMP=mysqldump
