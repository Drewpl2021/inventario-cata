APP_NAME=SIBIP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sibip
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo (recuperación de contraseña). En local se usa "log": los correos
# quedan en storage/logs/laravel.log en lugar de enviarse.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sibip@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Ejemplo con Gmail (o Google Workspace del colegio):
# 1. Active la verificación en dos pasos de la cuenta.
# 2. Cree una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#    (16 caracteres, sin espacios). NO use la contraseña normal de la cuenta.
# 3. Reemplace el bloque anterior por:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=inventario@cata.edu.pe
# MAIL_PASSWORD=abcdefghijklmnop
# MAIL_FROM_ADDRESS="inventario@cata.edu.pe"
# MAIL_FROM_NAME="SIBIP - Colegio Adventista Túpac Amaru"
# Pruebe el envío con: php artisan tinker --execute 'Illuminate\Support\Facades\Mail::raw("Prueba SIBIP", fn ($m) => $m->to("su-correo@cata.edu.pe")->subject("Prueba"));'

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Administrador inicial (php artisan db:seed). Contraseña temporal: se pide cambiarla al entrar.
SIBIP_ADMIN_EMAIL=
SIBIP_ADMIN_PASSWORD=
SIBIP_ADMIN_NOMBRE=Administrador
SIBIP_ADMIN_APELLIDO=SIBIP

# Reportes: por encima de este número de registros, el Excel se genera en la cola (requiere worker).
SIBIP_LIMITE_EXCEL_DIRECTO=1000

# Respaldos diarios (php artisan sibip:respaldar): carpeta, días que se conservan, hora y ruta de mysqldump.
SIBIP_RESPALDOS_DIAS=14
SIBIP_RESPALDOS_HORA=02:30
# SIBIP_RESPALDOS_RUTA=/var/www/sibip/storage/app/respaldos
# SIBIP_MYSQLDUMP="C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysqldump.exe"   # en Windows con Laragon
